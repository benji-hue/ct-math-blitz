{
  "name": "ct-math-blitz",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "ios:assets": "node scripts/ios-assets.mjs",
    "ios:add": "npm run build && npx cap add ios && npm run ios:assets",
    "ios:sync": "npm run build && npx cap sync ios && npm run ios:assets",
    "pwa:assets": "node scripts/pwa-assets.mjs",
    "build:pwa": "npm run build && node scripts/make-sw.mjs",
    "test": "vitest run",
    "check": "tsc -b && oxlint && vitest run",
    "worker:install": "npm --prefix worker install",
    "worker:test": "npm --prefix worker test",
    "worker:dev": "npm run build && npm --prefix worker run dev",
    "worker:deploy": "npm run build && npm --prefix worker run deploy"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/onest": "^5.3.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "motion": "^14.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-fsrs": "^6.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
