{
  // Cloudflare Worker «Крок»: мини-апп + ИИ-прокси + Telegram-бот.
  // Пошаговая инструкция — docs/ДЕПЛОЙ.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "krok",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Сборка мини-аппа (npm run build в корне) раздаётся этим же воркером.
  // API и вебхук обрабатывает код воркера, всё остальное — статика с SPA-фолбэком.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot/*"]
  },

  // Cloudflare Workers AI: бесплатно 10 000 нейронов в день, без внешних ключей.
  "ai": { "binding": "AI" },

  // База для лимитов и напоминаний. database_id выдаст `wrangler d1 create krok`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "krok",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Напоминания: раз в час, на 5-й минуте.
  "triggers": { "crons": ["5 * * * *"] },

  "vars": {
    // Две модели (docs/ВЫБОР-МОДЕЛИ.md): Gemini 3.5 Flash-Lite — основная, если задан
    // секрет GEMINI_API_KEY; Qwen 3.8 на Workers AI — запасная и единственная без ключа.
    // Обе понимают фото решений. Порядок для фото можно задать отдельно.
    "AI_PROVIDERS": "gemini,workers-ai",
    "AI_VISION_PROVIDERS": "gemini,workers-ai",
    "WORKERS_AI_MODELS": "@cf/qwen/qwen3.8-27b",
    "WORKERS_AI_VISION_MODELS": "@cf/qwen/qwen3.8-27b",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // Любой OpenAI-совместимый API (нужен секрет OPENAI_API_KEY), например
    // Groq: https://api.groq.com/openai/v1, DeepSeek: https://api.deepseek.com/v1.
    "OPENAI_BASE_URL": "",
    "OPENAI_MODEL": "",
    "MINI_APP_URL": "",
    "ALLOWED_ORIGINS": "",
    "ALLOW_ANONYMOUS": "false",
    "ALLOW_MOCK_AI": "false",
    "DAILY_LIMIT_CHAT": "60",
    "DAILY_LIMIT_GENERATE": "15",
    "DAILY_LIMIT_ANALYZE": "6",
    "DAILY_LIMIT_VISION": "12",
    // Гости сайта (ALLOW_ANONYMOUS): все вместе за день — не больше, чем столько учеников.
    "ANON_TOTAL_FACTOR": "5"
  }
}
